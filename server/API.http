# This file could be used for testing the API with Visual Studio Code

## Check the current session before login.
GET http://localhost:3001/api/sessions/current HTTP/1.1
###

## Login with username and password.
POST http://localhost:3001/api/sessions HTTP/1.1
Content-Type: application/json

{
	"mail": "gianni@example.com",
	"password": "password"
}
###

## Check the current session after login.
GET http://localhost:3001/api/sessions/current HTTP/1.1
###

## Enable TOTP mode for an admin user.
POST http://localhost:3001/api/login-totp HTTP/1.1
Content-Type: application/json

{
	"code": "371794"
}
###

## Logout.
DELETE http://localhost:3001/api/sessions/current HTTP/1.1
###

## Get the public theater map.
GET http://localhost:3001/api/theater HTTP/1.1
###

## Get all reservations.
GET http://localhost:3001/api/reservations HTTP/1.1
###

## Get reservations for a specific id route.
GET http://localhost:3001/api/reservations/1 HTTP/1.1
###

## Get the theater map.
GET http://localhost:3001/api/theater HTTP/1.1
###

## Get all reservations
GET http://localhost:3001/api/reservations HTTP/1.1
###

## Create a reservation by direct seat selection.
POST http://localhost:3001/api/reservations/direct HTTP/1.1
Content-Type: application/json

{
	"seatIds": [45, 46]
}
###

## Create a reservation by automatic assignment.
POST http://localhost:3001/api/reservations/assign HTTP/1.1
Content-Type: application/json

{
	"count": 3,
	"category": "normal"
}
###

## Create a premium reservation by automatic assignment.
POST http://localhost:3001/api/reservations/assign HTTP/1.1
Content-Type: application/json

{
	"count": 2,
	"category": "fffpremium"
}
###


GET http://localhost:3001/api/seats/-10 HTTP/1.1


### Delete reservation by ID
DELETE http://localhost:3001/api/reservations/72 HTTP/1.1
Content-Type: application/json

